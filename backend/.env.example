# Copy this file to `.env` before running the backend:
#   cp .env.example .env

# SQLite database file (relative to the `prisma/` directory)
DATABASE_URL="file:./dev.db"

# Secret used to sign JWT access tokens — change this in production
JWT_SECRET="pyramid-super-secret-key-2026"

# Port the NestJS API listens on
PORT=4000
