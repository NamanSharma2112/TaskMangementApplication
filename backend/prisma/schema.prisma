generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  password     String?
  name         String
  avatar       String?
  role         String    @default("MEMBER") // ADMIN, MANAGER, MEMBER, GUEST
  isGuest      Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  tasks        Task[]    @relation("AssignedTasks")
  createdTasks Task[]    @relation("CreatedTasks")
  projects     Project[] @relation("ProjectLead")
  comments     Comment[]
}

model Task {
  id          String     @id @default(uuid())
  title       String
  description String?
  status      String     @default("todo") // todo, in-progress, completed, on-hold
  priority    String     @default("medium") // low, medium, high, urgent
  category    String     @default("General")
  dueDate     String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  assigneeId  String?
  assignee    User?      @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId   String?
  creator     User?      @relation("CreatedTasks", fields: [creatorId], references: [id], onDelete: SetNull)
  subtasks    Subtask[]
  comments    Comment[]
  resources   Resource[]
}

model Resource {
  id        String   @id @default(uuid())
  title     String
  url       String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
}

model Subtask {
  id        String  @id @default(uuid())
  title     String
  completed Boolean @default(false)
  taskId    String
  task      Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
}

model Project {
  id          String   @id @default(uuid())
  title       String
  description String?
  category    String   @default("Web App")
  status      String   @default("Active")
  priority    String   @default("high")
  dueDate     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  leadId      String?
  lead        User?    @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
}
